[Unit]
Description=Salvium pool wallet (wallet-rpc, 127.0.0.1:19998, no password: local use only)
After=sal-node.service
Requires=sal-node.service

[Service]
Type=simple
User=salpool
ExecStart=/opt/salvium/bin/salvium-wallet-rpc --wallet-file /opt/salvium/wallet/pool --password-file /opt/salvium/wallet/password --rpc-bind-ip 127.0.0.1 --rpc-bind-port 19998 --disable-rpc-login --daemon-address 127.0.0.1:19995 --trusted-daemon --log-file /opt/salvium/wallet/wallet-rpc.log --max-log-file-size 0
Restart=on-failure
RestartSec=15
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
