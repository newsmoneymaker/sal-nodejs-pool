[Unit]
Description=Salvium pool: block unlocker (credits the miners after the coinbase maturity)
After=sal-pool-redis.service sal-node.service sal-wallet-rpc.service
Requires=sal-pool-redis.service
[Service]
Type=simple
User=salpool
WorkingDirectory=/opt/sal-nodejs-pool
ExecStart=/usr/bin/node /opt/sal-nodejs-pool/init.js -module=unlocker
Restart=always
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
